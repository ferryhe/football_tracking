{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "start": "node scripts/project.mjs start",
    "stop": "node scripts/project.mjs stop",
    "status": "node scripts/project.mjs status",
    "check": "node scripts/project.mjs check",
    "test": "node scripts/project.mjs test",
    "train": "node scripts/project.mjs train",
    "validate:full-video": "node scripts/project.mjs validate-full-video",
    "build": "node scripts/run-pnpm.mjs run typecheck && node scripts/run-pnpm.mjs -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "node scripts/run-pnpm.mjs run typecheck:libs && node scripts/run-pnpm.mjs -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
